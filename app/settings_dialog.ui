      <widget class="QSpinBox" name="debounceSpin">
       <property name="minimum">
        <number>200</number>
       </property>
       <property name="maximum">
        <number>60000</number>
       </property>
       <property name="singleStep">
        <number>500</number>
       </property>
       <property name="value">
        <number>2000</number>
       </property>
       <property name="suffix">
        <string> 毫秒</string>
       </property>
